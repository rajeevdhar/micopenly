# Supabase → your micopenly project → Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable key (sb_publishable_...) — safe for the browser.
VITE_SUPABASE_ANON_KEY=sb_publishable_your_key_here

# Dev only: show a few clearly-labelled sample listings when Supabase isn't configured.
# VITE_DEMO_DATA=1

# ── Email alerts: set these ONLY on the separate Railway "worker" service (start: node server/worker.js) ──
# Never on the web service, and never with a VITE_ prefix (that would put them in the browser bundle).
# The worker also needs the same VITE_SUPABASE_URL as the web service (or SUPABASE_URL).
# SUPABASE_SERVICE_ROLE_KEY=      # Supabase → Settings → API → "service_role" / secret key
# ADMIN_EMAIL=you@example.com     # who gets the new-submission / problem-report digest (comma-separate several; blank = every admin's account email)
# MAIL_FROM="MicOpenly <you@example.com>"
# Choose ONE mail provider:
# RESEND_API_KEY=                 # resend.com. Until you verify a domain it can only send to your own Resend account email.
# SMTP_URL=smtps://you%40gmail.com:APP_PASSWORD@smtp.gmail.com:465   # e.g. Gmail with an app password
# SITE_URL=https://micopenly-production.up.railway.app
